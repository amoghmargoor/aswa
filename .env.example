# ASWA - Environment Configuration Example
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

####################
# Application
####################
APP_NAME=aswa
APP_VERSION=0.1.0
ASWA_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

####################
# Database (PostgreSQL)
####################
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aswa
DB_USER=aswa
DB_PASSWORD=aswa_dev_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

####################
# Redis (Cache & Message Broker)
####################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

####################
# Vector Database (Pinecone)
####################
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=aswa-embeddings
PINECONE_DIMENSION=1536

####################
# LLM Configuration
####################
# Options: bedrock, azure_openai
LLM_PROVIDER=bedrock

# AWS Bedrock settings (if using bedrock)
LLM_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Azure OpenAI settings (if using azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# LLM parameters
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0

####################
# Authentication & Security
####################
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-chars-long
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
API_KEY_SALT=your-api-key-salt
ENCRYPTION_KEY=your-encryption-key-for-credentials-32bytes

####################
# CORS Configuration
####################
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

####################
# API Gateway
####################
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_CONTEXT_PATH=/
API_RATE_LIMIT_PER_MINUTE=60
API_REQUEST_TIMEOUT_SECONDS=30

####################
# Ingestion Service
####################
INGESTION_SERVICE_PORT=8081
INGESTION_POLL_INTERVAL_SECONDS=300
INGESTION_BATCH_SIZE=100
INGESTION_MAX_WORKERS=4

####################
# Insight Engine
####################
INSIGHT_ENGINE_PORT=8082
INSIGHT_CONFIDENCE_THRESHOLD=0.7
INSIGHT_BATCH_SIZE=10
INSIGHT_MAX_RETRIES=3

####################
# Query Service
####################
QUERY_SERVICE_PORT=8083
QUERY_MAX_RESULTS=100
QUERY_CACHE_TTL_SECONDS=300
VECTOR_SEARCH_TOP_K=10

####################
# Notification Service
####################
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=60

####################
# Integration Service
####################
INTEGRATION_SERVICE_PORT=8085

####################
# Slack Bot
####################
SLACK_BOT_PORT=8086
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

####################
# Email Configuration (for notifications)
####################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@aswa.example.com
SMTP_FROM_NAME=ASWA Notifications
SMTP_USE_TLS=true

####################
# Data Source Integrations
####################
# Gmail
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080/oauth/gmail/callback

# Outlook
OUTLOOK_CLIENT_ID=your-outlook-oauth-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-oauth-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:8080/oauth/outlook/callback

# Slack (workspace integration)
SLACK_CLIENT_ID=your-slack-oauth-client-id
SLACK_CLIENT_SECRET=your-slack-oauth-client-secret
SLACK_REDIRECT_URI=http://localhost:8080/oauth/slack/callback

# Microsoft Teams
TEAMS_CLIENT_ID=your-teams-oauth-client-id
TEAMS_CLIENT_SECRET=your-teams-oauth-client-secret
TEAMS_REDIRECT_URI=http://localhost:8080/oauth/teams/callback

# Google Drive
GDRIVE_CLIENT_ID=your-gdrive-oauth-client-id
GDRIVE_CLIENT_SECRET=your-gdrive-oauth-client-secret
GDRIVE_REDIRECT_URI=http://localhost:8080/oauth/gdrive/callback

# SharePoint
SHAREPOINT_CLIENT_ID=your-sharepoint-oauth-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-oauth-client-secret
SHAREPOINT_REDIRECT_URI=http://localhost:8080/oauth/sharepoint/callback

# Salesforce
SALESFORCE_CLIENT_ID=your-salesforce-oauth-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-oauth-client-secret
SALESFORCE_REDIRECT_URI=http://localhost:8080/oauth/salesforce/callback

# Zoho
ZOHO_CLIENT_ID=your-zoho-oauth-client-id
ZOHO_CLIENT_SECRET=your-zoho-oauth-client-secret
ZOHO_REDIRECT_URI=http://localhost:8080/oauth/zoho/callback

# Confluence
CONFLUENCE_CLIENT_ID=your-confluence-oauth-client-id
CONFLUENCE_CLIENT_SECRET=your-confluence-oauth-client-secret
CONFLUENCE_REDIRECT_URI=http://localhost:8080/oauth/confluence/callback

# Notion
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_REDIRECT_URI=http://localhost:8080/oauth/notion/callback

# Zoom
ZOOM_CLIENT_ID=your-zoom-oauth-client-id
ZOOM_CLIENT_SECRET=your-zoom-oauth-client-secret
ZOOM_REDIRECT_URI=http://localhost:8080/oauth/zoom/callback

####################
# Observability & Monitoring
####################
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

####################
# Worker Configuration
####################
# Document Processor
DOCUMENT_PROCESSOR_WORKERS=2
DOCUMENT_PROCESSOR_BATCH_SIZE=10
DOCUMENT_CHUNK_SIZE=512
DOCUMENT_CHUNK_OVERLAP=50

# Pattern Analyzer
PATTERN_ANALYZER_WORKERS=2
PATTERN_ANALYZER_WINDOW_DAYS=30
PATTERN_ANALYZER_MIN_CONFIDENCE=0.6

####################
# Feature Flags
####################
FEATURE_VECTOR_SEARCH=true
FEATURE_PATTERN_DETECTION=true
FEATURE_RELATIONSHIP_MAPPING=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_SLACK_BOT=true

####################
# Development/Testing
####################
TESTCONTAINERS_RYUK_DISABLED=false
TESTCONTAINERS_HUB_IMAGE_NAME_PREFIX=
MOCK_LLM_RESPONSES=false
SEED_DEV_DATA=true

####################
# Docker/Kubernetes
####################
DOCKER_REGISTRY=your-docker-registry.com
K8S_NAMESPACE=aswa
K8S_CLUSTER_NAME=aswa-cluster
